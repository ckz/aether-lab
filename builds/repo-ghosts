#!/usr/bin/env bash
# repo-ghosts — find the abandoned files haunting your git repo
# Usage: repo-ghosts [path]
set -uo pipefail

REPO_DIR="${1:-.}"
cd "$REPO_DIR" 2>/dev/null || { echo "Not a git repo: $REPO_DIR"; exit 1; }

# Colors (only if terminal)
if [ -t 1 ]; then
  C_RESET='\033[0m'; C_DIM='\033[2m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'
  C_CYAN='\033[0;36m'; C_RED='\033[0;31m'; C_PURPLE='\033[0;35m'; C_BOLD='\033[1m'
else
  C_RESET=''; C_DIM=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_RED=''; C_PURPLE=''; C_BOLD=''
fi

NOW=$(date +%s)
TOTAL=$(git ls-files | wc -l | tr -d ' ')

if [ "$TOTAL" -eq 0 ]; then
  echo "Empty repo. No ghosts here."
  exit 0
fi

# ── Single-pass ghost detection ──────────────────────────────────────────
# For each file tracked in the repo, compute:
#   commit count, first-commit timestamp, last-commit timestamp, size
# Strategy: dump all commit metadata in 3 git log passes, then awk-join.

# Pass 1: commit count + last timestamp per file
# Format: <timestamp> <hash> \n <filename> \n ...
git log --follow --format='COMMIT %at %H' --name-only 2>/dev/null | awk '
  /^COMMIT / { ts=$2; commit=$3; next }
  /^$/ { next }
  NF {
    count[$0]++
    if (!(last[$0]) || ts > last[$0]) last[$0]=ts
    if (!(first[$0]) || ts < first[$0]) first[$0]=ts
  }
  END {
    for (f in count) printf "%s|%d|%d|%d\n", f, count[f], first[f], last[f]
  }
' | sort -t'|' -k1,1 > /tmp/ghost_meta_$$.txt

# Ghost classification
TMPFILE=$(mktemp)
trap 'rm -f /tmp/ghost_meta_$$.txt "$TMPFILE"' EXIT

GHOST_COUNT=0
while IFS='|' read -r file count first_ts last_ts; do
  [ -z "$file" ] && continue
  size=$(stat -c%s -- "$file" 2>/dev/null || echo 0)

  age_days=$(( (NOW - first_ts) / 86400 ))
  last_age_days=$(( (NOW - last_ts) / 86400 ))

  if [ "$last_age_days" -lt 30 ] || [ "$count" -gt 2 ]; then
    continue
  fi

  if [ "$count" -eq 1 ] && [ "$age_days" -ge 365 ]; then
    cls="💀 SKELETON"; color="$C_RED"
  elif [ "$count" -eq 1 ] && [ "$age_days" -ge 90 ]; then
    cls="👻 GHOST"; color="$C_PURPLE"
  elif [ "$count" -eq 1 ] && [ "$age_days" -ge 30 ]; then
    cls="🦇 FORGOTTEN"; color="$C_YELLOW"
  elif [ "$count" -eq 2 ]; then
    cls="🕸️ WEB"; color="$C_CYAN"
  else
    cls="👁️ WISP"; color="$C_DIM"
  fi

  size_kb=$((size / 1024))
  [ "$size_kb" -lt 1 ] && size_str="${size}B" || size_str="${size_kb}KB"

  printf '%s|%s|%s|%s|%s|%s\n' "$color$cls$C_RESET" "$file" "$age_days" "$last_age_days" "$count" "$size_str" >> "$TMPFILE"
  GHOST_COUNT=$((GHOST_COUNT + 1))
done < /tmp/ghost_meta_$$.txt

SORTED_GHOSTS=$(sort -t'|' -k3 -rn "$TMPFILE")

# ── Output ───────────────────────────────────────────────────────────────
echo ""
echo -e "${C_BOLD}╔══════════════════════════════════════════════════════════╗${C_RESET}"
echo -e "${C_BOLD}║${C_RESET}  👻 repo-ghosts — the abandoned files haunting you       ${C_BOLD}║${C_RESET}"
echo -e "${C_BOLD}╚══════════════════════════════════════════════════════════╝${C_RESET}"
echo ""
echo -e "  Repo: ${C_CYAN}$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo .)")${C_RESET}"
echo -e "  Files tracked: ${C_BOLD}$TOTAL${C_RESET}  |  Ghosts found: ${C_BOLD}${GHOST_COUNT}${C_RESET}"
if [ "$TOTAL" -gt 0 ]; then
  pct=$((GHOST_COUNT * 100 / TOTAL))
  echo -e "  Haunting ratio: ${C_PURPLE}${pct}%${C_RESET} of your repo is abandoned"
fi
echo ""

if [ "$GHOST_COUNT" -eq 0 ]; then
  echo -e "  ${C_GREEN}✨ No ghosts! Your repo is clean and loved.${C_RESET}"
  echo ""
  exit 0
fi

echo -e "  ${C_BOLD}Legend:${C_RESET} ${C_RED}💀 SKELETON${C_RESET}=1 commit, >1yr  ${C_PURPLE}👻 GHOST${C_RESET}=1 commit, 90d-1yr"
echo -e "           ${C_YELLOW}🦇 FORGOTTEN${C_RESET}=1 commit, 30d-90d  ${C_CYAN}🕸️ WEB${C_RESET}=2 commits, >30d"
echo ""
echo -e "  ${C_BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_BOLD}%-14s %-38s %8s %8s %5s${C_RESET}\n" "TYPE" "FILE" "AGE" "LAST" "SIZE"
echo -e "  ${C_BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"

while IFS='|' read -r cls file age last_age _count size_str; do
  [ -z "$file" ] && continue
  if [ "$age" -ge 365 ]; then
    age_display="${C_DIM}${age}d ($((age/365))yr)${C_RESET}"
  elif [ "$age" -ge 90 ]; then
    age_display="${C_PURPLE}${age}d${C_RESET}"
  else
    age_display="${C_YELLOW}${age}d${C_RESET}"
  fi
  if [ ${#file} -gt 36 ]; then
    fname="...${file:(-33)}"
  else
    fname="$file"
  fi
  printf "  %-14s %-38s %8s %8s %5s\n" "$cls" "$fname" "$age_display" "${last_age}d" "$size_str"
done <<< "$SORTED_GHOSTS"

echo -e "  ${C_BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo ""

echo -e "  ${C_BOLD}🏚️  Most haunted directories:${C_RESET}"
cut -d'|' -f2 "$TMPFILE" | xargs -I{} dirname {} 2>/dev/null | sort | uniq -c | sort -rn | head -5 | while read -r count dir; do
  [ -z "$dir" ] && continue
  [ "$dir" = "." ] && dir_display="(root)" || dir_display="$dir"
  echo -e "    ${C_DIM}${count} ghosts${C_RESET}  in ${C_CYAN}${dir_display}${C_RESET}"
done

echo ""
echo -e "  ${C_DIM}Tip: ghosts are files with ≤2 commits, untouched for 30+ days.${C_RESET}"
echo -e "  ${C_DIM}Not always bad — sometimes a ghost is a feature, not a bug.${C_RESET}"
echo -e "  ${C_DIM}Run with a path to scan a specific repo: repo-ghosts /path/to/repo${C_RESET}"
echo ""
